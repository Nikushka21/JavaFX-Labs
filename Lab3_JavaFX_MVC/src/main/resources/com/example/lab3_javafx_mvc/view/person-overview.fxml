
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lab3_javafx_mvc.controller.PersonOverviewController"
            prefWidth="800.0" prefHeight="500.0">

    <top>
        <Label text="Адресная книга"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="20"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 15;">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Список людей"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <TableView fx:id="personTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="firstNameColumn"
                                     text="Имя" prefWidth="130"/>
                        <TableColumn fx:id="lastNameColumn"
                                     text="Фамилия" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12" prefWidth="270">
                <Label text="Информация о человеке"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Имя:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="firstNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Фамилия:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lastNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Улица:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="streetLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Город:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="cityLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Индекс:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="postalCodeLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="День рождения:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="birthdayLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <Button text="Удалить выбранного"
                        onAction="#handleDeletePerson"
                        maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
