
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lab3_javafx_mvc.controller.StudentInfoController"
            prefWidth="1000.0" prefHeight="600.0">

    <top>
        <Label text="Студенческая группа и студент"
               style="-fx-font-size: 26px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="20" right="20" bottom="15" left="25"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <HBox spacing="25" style="-fx-padding: 15 25 25 25;">

            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <Label text="Список студентов"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="lastNameColumn"
                                     text="Фамилия" prefWidth="170"/>
                        <TableColumn fx:id="firstNameColumn"
                                     text="Имя" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12" prefWidth="370">
                <Label text="Информация о группе"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <GridPane hgap="12" vgap="8">
                    <Label text="Группа:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="groupNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Факультет:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="facultyLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Курс:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="courseLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Обучение:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="studyFormLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <Label text="Информация о студенте"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>

                <GridPane hgap="12" vgap="12">
                    <Label text="Фамилия:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lastNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Имя:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="firstNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Отчество:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="middleNameLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Дата рождения:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="birthDateLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Телефон:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="phoneLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Электронная почта:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="emailLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

        </HBox>
    </center>
</BorderPane>
